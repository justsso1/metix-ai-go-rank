---
export const prerender = false;
import { ROUTES, showTaskPath } from '../../recruiters-view/site';

const taskId = Astro.url.searchParams.get('taskId')?.trim();
const target = new URL(Astro.url);
target.pathname = taskId ? showTaskPath(taskId) : ROUTES.entry;
target.searchParams.delete('taskId');
const redirect = Astro.redirect(`${target.pathname}${target.search}`, 302);
redirect.headers.set('Cache-Control', 'private, no-store');
return redirect;
---

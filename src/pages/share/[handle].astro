---
import { getMockShareResults } from '../../recruiters-view/mock';
import RecruitersViewPage from '../../recruiters-view/RecruitersViewPage.astro';

export function getStaticPaths() {
  return getMockShareResults().map((result) => ({
    params: { handle: result.profile.handle },
    props: { result },
  }));
}
const { result } = Astro.props;
---
<RecruitersViewPage result={result} />

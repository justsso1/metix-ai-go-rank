# Same API host mapping as openjobs-recruiter-ui. Public /bapi/ and /api/track/
# requests are forwarded to this origin's /hire/bapi/ and /hire/api/track/ paths.
NEXT_PUBLIC_ENV=dev
NEXT_PUBLIC_API_BASE=https://www-dev.metix.ai
# The API base is read by the dev proxy and Nginx at runtime. Use the matching
# openjobs-recruiter-ui value: dev=www-dev.metix.ai, test=www-test.metix.ai,
# prod=www.metix.ai. Keep this as an origin without paths or credentials.
